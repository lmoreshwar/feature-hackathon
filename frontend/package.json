{
  "name": "hackathon-frontend",
  "version": "0.1.0",
  "description": "Angular frontend for the Hackathon NestJS backend (NG-ZORRO based).",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
