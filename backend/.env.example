PORT=3000
MONGO_URI=mongodb://admin:SecurePassword123!@localhost:27017/myappdb?authSource=admin
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
# Used to AES-encrypt integration secrets stored in MongoDB. Min 32 random bytes recommended.
ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
# Comma-separated list of origins allowed by CORS (used by the Angular frontend)
CORS_ORIGINS=http://localhost:4200
